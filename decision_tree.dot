digraph G {
    // General Graph Settings
    brainfact=true;
    nodesep=0.5;
    ranksep=0.4;
    compound=true;
    fontname="Helvetica,Arial,sans-serif";
    
    // Default Node Settings
    node [fontname="Helvetica,Arial,sans-serif", fontsize=11, shape=box, style=filled, fillcolor="#F3F4F6", color="#374151", penwidth=1.5];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=10, color="#4B5563", penwidth=1.5];

    // Core Pipeline Nodes
    Start [label="START\nTimestamped Event Data", shape=ellipse, fillcolor="#ECFDF5", color="#059669"];
    
    // Decision Nodes (Diamonds)
    Q_Stationary [label="Is the process Stationary?\n\n[Check: Linear regression slope\nof event density over time]", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    
    Q_Overdisp_Stat [label="Is there Overdispersion?\n\n[Check: Global Dispersion Index\nVariance / Mean > 1]", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    Q_Overdisp_Non  [label="Is there Residual Overdispersion?\n\n[Check: Pearson Residuals ratio\nafter detrending time decay]", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    
    Q_Hist_Stat  [label="Does History Matter?\n\n[Check: Lag-1 Autocorrelation\nof inter-arrival times]", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    Q_Hist_Non   [label="Does History Matter?\n\n[Check: Residual autocorrelation\nafter detrending time decay]", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    
    Q_Dir_Stat   [label="Direction of History Effect?", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    Q_Dir_Non    [label="Direction of History Effect?", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    Q_Inhib      [label="Is it a 'cooldown' after\nthe SINGLE last event?", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];
    
    // FIXED: Choice of f(t) structure integrated into the tree routing
    Q_Trend_Type [label="Is the time-drop trend simple or complex?\n\n[Check: Does it follow a known physical curve\nor is it highly irregular/non-linear?]", shape=diamond, fillcolor="#EFF6FF", color="#2563EB"];

    // Final Model Destinations with Math/GLM context equations
    M_Poisson       [label="Homogeneous Poisson Process\n\nlog(E[Y]) = β₀ + β₁·G\n• Equidispersed count regression", fillcolor="#FEF3C7", color="#D97706"];
    M_NegBin_Stat   [label="Negative Binomial Regression\n\nlog(E[Y]) = β₀ + β₁·G\n• Var[Y] = μ + α·μ²\n• Absorbs subject-level frailty", fillcolor="#FEF3C7", color="#D97706"];
    M_Hawkes_Stat   [label="Standard Hawkes Process\n\nλ(t) = exp(β₀ + β₁·G) + α · Σ exp(-β·(t - tᵢ))\n• Constant baseline\n• Self-excitation explains overdispersion", fillcolor="#FEF3C7", color="#D97706"];
    M_Renew_Stat    [label="Standard Renewal Process\n\nlog(E[Xᵢ]) = β₀ + β₁·G\n• Models inter-arrival times Xᵢ\n• Underdispersed (Variance < Mean)", fillcolor="#FEF3C7", color="#D97706"];
    
    M_Inhom_Poi_Param [label="Inhomogeneous Poisson (Parametric)\n\nlog(λ(t)) = β₀ + β₁·G + β₂·t\n• e.g., Linear/Exponential functional drop\n• Clean, predictable behavior at infinity", fillcolor="#FEF3C7", color="#D97706"];
    M_Inhom_Poi_Spline [label="Inhomogeneous Poisson (Non-Parametric)\n\nlog(λ(t)) = β₀ + β₁·G + s(t)\n• Uses smooth splines / GAMs\n• Captures complex, fluctuating time decay", fillcolor="#FEF3C7", color="#D97706"];
    
    M_Inhom_NB      [label="Inhomogeneous Negative Binomial\n\nlog(E[Yₜ]) = β₀ + β₁·G + f(t) + log(Offset)\n• Mixed parametric/spline trend control\n• Absorbs unexplained subject variance", fillcolor="#FEF3C7", color="#D97706"];
    M_Inhom_Hawk    [label="Inhomogeneous Hawkes Process\n\nλ(t) = exp(β₀ + β₁·G + f(t)) + α(G) · Σ exp(-β·(t - tᵢ))\n• Parametric f(t) protects bounds\n• History clustering explains variance", fillcolor="#FEF3C7", color="#D97706"];
    M_Inhom_Ren     [label="Inhomogeneous Renewal Process\n\nλ(t) = (α/β) · (t/β)^(α-1) · exp(β₀ + β₁·G)\n• Non-stationary Weibull intensity setup\n• Time gaps rescale with overall baseline", fillcolor="#FEF3C7", color="#D97706"];
    M_Cox           [label="Cox Recurrent Events Model\n\nλ(t) = λ₀(t) · exp(β₁·G + β₂·History(t) + wᵢ)\n• Pure Non-Parametric baseline λ₀(t)\n• Time decay absorbed without explicit equations", fillcolor="#FEF3C7", color="#D97706"];

    // --- GRAPH CONNECTIONS ---
    Start -> Q_Stationary;
    
    // STATIONARY BRANCH
    Q_Stationary -> Q_Overdisp_Stat [label="YES\n(Constant Rate)", weight=2];
    
    Q_Overdisp_Stat -> Q_Hist_Stat [label="YES\n(Overdispersed)"];
    Q_Overdisp_Stat -> M_Poisson [label="NO\n(Variance ≈ Mean)"];
    
    Q_Hist_Stat -> M_NegBin_Stat [label="NO\n(Latent Heterogeneity / Frailty)"];
    Q_Hist_Stat -> Q_Dir_Stat [label="YES\n(True History Dependency)"];
    
    Q_Dir_Stat -> M_Hawkes_Stat [label="Positive\n(Clustering)"];
    Q_Dir_Stat -> M_Renew_Stat [label="Negative\n(Inhibition)"];
    
    // NON-STATIONARY BRANCH
    Q_Stationary -> Q_Overdisp_Non [label="NO\n(Rate Drops Over Time)"];
    
    Q_Overdisp_Non -> Q_Hist_Non [label="YES\n(Residual Overdispersion)"];
    
    // Route clean Poisson to trend-type selection
    Q_Overdisp_Non -> Q_Trend_Type [label="NO\n(Trend explains variance)"];
    Q_Trend_Type -> M_Inhom_Poi_Param [label="Simple / Bounded\n(Exponential/Power)"];
    Q_Trend_Type -> M_Inhom_Poi_Spline [label="Complex / Irregular\n(Splines/GAMs)"];
    
    Q_Hist_Non -> M_Inhom_NB [label="NO\n(Unexplained subject-level frailty)"];
    Q_Hist_Non -> Q_Dir_Non [label="YES\n(Time + History matter)"];
    
    Q_Dir_Non -> M_Inhom_Hawk [label="Positive\n(Self-Exciting Clusters)"];
    Q_Dir_Non -> Q_Inhib [label="Negative\n(Inhibition / Cooldown)"];
    
    Q_Inhib -> M_Inhom_Ren [label="YES\n(Resets window)"];
    Q_Inhib -> M_Cox [label="NO\n(Complex/Cumulative history)"];
}
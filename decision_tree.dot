digraph EventModelSelection {

    graph [
        rankdir=TB,
        nodesep=0.5,
        ranksep=0.6,
        splines=true,
        fontname="Helvetica"
    ];

    node [
        shape=box,
        style=filled,
        fillcolor="#F3F4F6",
        color="#374151",
        penwidth=1.5,
        fontname="Helvetica",
        fontsize=11
    ];

    edge [
        color="#4B5563",
        penwidth=1.3,
        fontname="Helvetica",
        fontsize=10
    ];


    //===========================================================
    // START
    //===========================================================

    Start [
        shape=ellipse,
        fillcolor="#DCFCE7",
        color="#15803D",
        label="START\nTimestamped event data"
    ];

    QTemporal [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="Is event timing itself\nbiologically meaningful?\n\nDo we care about:\n• bursts\n• refractory periods\n• event history?"
    ];


    //===========================================================
    // BINNED COUNTS BRANCH
    //===========================================================

    Bin [
        fillcolor="#E0F2FE",
        color="#0284C7",
        label="Bin events\n\nChoose Δt so within-bin\nrate is ~constant\nConvert timestamps → counts"
    ];

    Exposure [
        fillcolor="#E0F2FE",
        color="#0284C7",
        label="Unequal observation windows\nacross bins/subjects?\n\nAdd offset(log(exposure))"
    ];

    QTrendBin [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="Is baseline event rate\nstable over time?"
    ];

    CountTimeModel [
        fillcolor="#E0F2FE",
        color="#0284C7",
        label="Include time trend f(time)\n\nLinear / spline / GAM"
    ];

    QDispersion [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="Are counts\noverdispersed?\n\nVariance >> Mean"
    ];

    PoissonGLM [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Poisson regression\n\nlog(E[Y]) =\nβ0 + βGroup·Group + f(time)"
    ];

    NegBinGLMM [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Negative Binomial GLM(M)\n\nlog(E[Y]) =\nβ0 + βGroup·Group + f(time)"
    ];

    QZero [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="Structural excess zeros?\n(more zeros than\nPoisson/NB predicts)"
    ];

    ZeroInflated [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Zero-inflated / hurdle model\n\nSeparate:\nabsence vs. event rate"
    ];


    //===========================================================
    // POINT PROCESS BRANCH
    //===========================================================

    EstimateLambda [
        fillcolor="#E0F2FE",
        color="#0284C7",
        label="Estimate baseline intensity μ(t)\n\nKernel / spline / moving window"
    ];

    QStationaryPP [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="Is baseline intensity\nμ(t) stable?"
    ];

    ModelLambda [
        fillcolor="#E0F2FE",
        color="#0284C7",
        label="Model μ(t)\n\nParametric decay\nor spline/GAM"
    ];

    // --- split into two independent QHistory nodes, one per μ(t) branch ---

    QHistoryConst [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="μ(t) constant.\nDoes event history\nmodify future intensity?"
    ];

    QHistoryVar [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="μ(t) time-varying.\nAfter removing μ(t),\ndoes event history\nmodify future intensity?"
    ];

    HomogeneousPoisson [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Homogeneous Poisson Process\n\nλ(t) = constant\nIndependent events"
    ];

    InhomogeneousPoisson [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Inhomogeneous Poisson Process\n\nλ(t) = μ(t)\nNo history effect"
    ];

    // --- history dependence framed by which object is fundamental, not by direction ---

    QHistoryStructure [
        shape=diamond,
        fillcolor="#DBEAFE",
        color="#2563EB",
        label="What structure describes\nthe dependence?\n\nIs conditional intensity a direct\nfunction of past event times,\nor are inter-event intervals\nthemselves the modeled object?"
    ];

    Hawkes [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Hawkes / self-exciting process\n\nλ(t) = μ(t) + Σ g(t−ti), g ≥ 0\nAdditive excitation kernel\n(clustering, branching ratio)"
    ];

    SelfCorrecting [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Self-correcting / inhibitory process\n\nλ(t) = μ(t) − Σ h(t−ti)\nSubtractive full-history term\n(active suppression, not just\nthe last interval)"
    ];

    Renewal [
        fillcolor="#FEF3C7",
        color="#D97706",
        label="Renewal process\n\nInter-event intervals ~ i.i.d.\n(gamma, Weibull, log-normal...)\nMemory-1: only last event matters\nDirection set by hazard shape\n(shape<1 bursty, shape>1 regular)"
    ];

    QPointGOF [
        shape=diamond,
        fillcolor="#FCE7F3",
        color="#BE185D",
        label="Point-process GOF check\n\nTime-rescaling theorem:\nare rescaled inter-event\ntimes ~ Exp(1)?"
    ];


    //===========================================================
    // SUBJECT VARIABILITY
    //===========================================================

    QSubject [
        shape=diamond,
        fillcolor="#EDE9FE",
        color="#7C3AED",
        label="Important\nbetween-subject variability?\n(repeated bins/events\nper subject)"
    ];

    Mixed [
        fillcolor="#F5F3FF",
        color="#7C3AED",
        label="Hierarchical model / GEE\n\nRandom subject effect\nor frailty term\n(avoids pseudo-replication)"
    ];

    Fixed [
        fillcolor="#F5F3FF",
        color="#7C3AED",
        label="Fixed effects only\n\n(one subject/session\nper group, or already\ncollapsed to one\nrate per subject)"
    ];


    //===========================================================
    // VALIDATION
    //===========================================================

    Validate [
        shape=diamond,
        fillcolor="#FCE7F3",
        color="#BE185D",
        label="Good model fit?\n\nResiduals\nGoodness-of-fit\nPosterior predictive checks"
    ];

    Refine [
        fillcolor="#FCE7F3",
        color="#BE185D",
        label="Refine within current branch:\nadd trend / switch dispersion\nfamily / add history term /\nreconsider bin width\n\n(loop back to nearest\nrelevant decision, not to START)"
    ];


    //===========================================================
    // INFERENCE
    //===========================================================

    QParamVector [
        shape=diamond,
        fillcolor="#DCFCE7",
        color="#15803D",
        label="Which parameter(s)\ndoes Group modify?\n\nbaseline rate only, or also\nkernel/branching ratio,\nshape, decay?"
    ];

    Group [
        fillcolor="#DCFCE7",
        color="#15803D",
        label="Estimate group effect(s)\n\nβGroup (single param)\nor θGroup (vector)"
    ];

    Test [
        fillcolor="#DCFCE7",
        color="#15803D",
        label="Inference\n\nLikelihood ratio test\n(nested models)\nWald test / CIs"
    ];

    Bootstrap [
        fillcolor="#DCFCE7",
        color="#15803D",
        label="Bootstrap\n\nResample subjects\n(not events)"
    ];

    Permutation [
        fillcolor="#DCFCE7",
        color="#15803D",
        label="Permutation test\n\nShuffle group labels\n(distribution-free check)"
    ];

    RobustnessNote [
        shape=note,
        fillcolor="#F0FDF4",
        color="#15803D",
        fontsize=9,
        label="Bootstrap and permutation are\ncomplementary robustness checks,\nnot both mandatory — pick based on\nhow much you trust parametric\nassumptions and independence."
    ];


    //===========================================================
    // CONNECTIONS
    //===========================================================

    Start -> QTemporal;

    //---------------------------
    // Counts branch
    //---------------------------

    QTemporal -> Bin [label="NO"];
    Bin -> Exposure;
    Exposure -> QTrendBin;

    QTrendBin -> QDispersion [label="YES\nstable rate"];
    QTrendBin -> CountTimeModel [label="NO"];
    CountTimeModel -> QDispersion;

    QDispersion -> PoissonGLM [label="NO"];
    QDispersion -> NegBinGLMM [label="YES"];

    PoissonGLM -> QZero;
    NegBinGLMM -> QZero;

    QZero -> ZeroInflated [label="YES"];
    QZero -> QSubject [label="NO"];
    ZeroInflated -> QSubject;

    //---------------------------
    // Point process branch
    //---------------------------

    QTemporal -> EstimateLambda [label="YES"];
    EstimateLambda -> QStationaryPP;

    QStationaryPP -> QHistoryConst [label="YES\nconstant μ"];
    QStationaryPP -> ModelLambda [label="NO\nchanging μ"];
    ModelLambda -> QHistoryVar;

    QHistoryConst -> HomogeneousPoisson [label="NO"];
    QHistoryConst -> QHistoryStructure [label="YES"];

    QHistoryVar -> InhomogeneousPoisson [label="NO"];
    QHistoryVar -> QHistoryStructure [label="YES"];

    QHistoryStructure -> Hawkes [label="intensity = f(past events),\nadditive, non-negative kernel"];
    QHistoryStructure -> SelfCorrecting [label="intensity = f(past events),\nsubtractive, full history"];
    QHistoryStructure -> Renewal [label="intervals themselves\nare i.i.d. (memory-1)"];

    HomogeneousPoisson -> QPointGOF;
    InhomogeneousPoisson -> QPointGOF;
    Hawkes -> QPointGOF;
    SelfCorrecting -> QPointGOF;
    Renewal -> QPointGOF;

    QPointGOF -> Refine [label="NO, poor fit"];
    QPointGOF -> QSubject [label="YES"];

    //---------------------------
    // Merge: subject variability
    //---------------------------

    QSubject -> Mixed [label="YES"];
    QSubject -> Fixed [label="NO"];

    Mixed -> Validate;
    Fixed -> Validate;

    Validate -> Refine [label="NO"];
    Validate -> QParamVector [label="YES"];

    //---------------------------
    // Inference
    //---------------------------

    QParamVector -> Group;
    Group -> Test;

    Test -> Bootstrap;
    Test -> Permutation;
    Bootstrap -> RobustnessNote [style=dashed, arrowhead=none];
    Permutation -> RobustnessNote [style=dashed, arrowhead=none];
}